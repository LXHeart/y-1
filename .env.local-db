# 本地 postgres 覆盖（e2e 用）——替代远程 neon。
#
# 起因：neon 连接不稳（实测宿主机直连 3 次 2 失败、成功一次 15.9s），每次活动 ~10s 延迟；
# 本地库实测稳定 ~80ms。时间驱动的 workflow 链路 e2e 尤其需要可靠的 DB。
#
# 用法：
#   docker compose --env-file .env --env-file .env.local-db \
#     --profile java-edge --profile local-db up -d
#
# 注意 --env-file 会完全替换默认的 .env 加载，故须显式列出两个文件（后者覆盖前者）。
# 不切本地库时正常 `docker compose --profile java-edge up -d` 即可，行为不变。
#
# 宿主机侧连接（跑 npx tsx 脚本 / psql）：
#   postgresql://grassland:grassland@localhost:55432/grassland

# 容器内服务名寻址（各 Java 服务与 backend 用这个）
DATABASE_URL=postgresql://grassland:grassland@postgres-local:5432/grassland

# 本地库凭据（与 docker-compose.yml 的 postgres-local 段一致）
LOCAL_DB_USER=grassland
LOCAL_DB_PASSWORD=grassland
LOCAL_DB_NAME=grassland
LOCAL_DB_PORT=55432

# e2e 便利：窗口缩到 30s，使时间驱动链路（窗口到期→自动 tally→decided）可在分钟级验证
TRUST_ADJUDICATION_VOTE_WINDOW_SECONDS=30
TRUST_ADJUDICATION_APPEAL_WINDOW_SECONDS=30
SETTLEMENT_WINDOW_SECONDS=5
