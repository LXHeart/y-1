FROM node:20-bookworm AS build
WORKDIR /app

COPY package.json package-lock.json ./
COPY server/tsconfig.json ./server/tsconfig.json
RUN npm ci

COPY . .
RUN npm run build:server

FROM node:20-bookworm-slim AS runtime
WORKDIR /app

# 国内网络环境下切换 Debian 源到 USTC 镜像，避免 apt 拉取超时
RUN sed -i 's|deb.debian.org|mirrors.ustc.edu.cn|g; s|security.debian.org|mirrors.ustc.edu.cn|g' \
      /etc/apt/sources.list.d/debian.sources \
  && apt-get update \
  && apt-get install -y --no-install-recommends ffmpeg \
  && rm -rf /var/lib/apt/lists/*

COPY package.json package-lock.json ./
RUN npm ci --omit=dev

COPY --from=build /app/server/dist ./server/dist

RUN mkdir -p /app/server/.data/douyin-audio /app/server/.data/bilibili-media

ENV NODE_ENV=production
EXPOSE 3000
CMD ["node", "server/dist/index.js"]
