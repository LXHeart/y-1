+import type { Composition, VisualPresent, VisualMediaElement } from '@hypit/composition';
+import type { ProgramSpace } from '@hypit/program-space';
+import type { HyperframesFrameSpan } from './types.js';
+
+export const MEDIA_SEGMENTS_MARKER = '<!--y1-media-segments-v1:';
+export type MediaSegment = HyperframesFrameSpan & { readonly media?: VisualMediaElement; readonly sourceStartFrame?: number };
+
+/** Only a single, untransformed full-canvas raster is equivalent to FFmpeg scale.
+ * Everything else (including overlapping subtitles) stays on the native renderer.
+ */
+export function planMediaSegments(composition: Composition, range: HyperframesFrameSpan, frameRate?: ProgramSpace['frameRate']): MediaSegment[] {
+  const presents = composition.tracks.flatMap(track => track.kind === 'visual' ? track.presents : []);
+  // Programs may install global styles/listeners, even outside their own span.
+  if (presents.some(p => p.elements.some(e => e.kind === 'program'))) return [{ ...range }];
+  const spans = (p: VisualPresent) => p.visibility ?? [p.span];
+  const boundaries = new Set([range.startFrame, range.endFrameExclusive]);
+  for (const p of presents) for (const s of spans(p)) {
+    for (const f of [s.startFrame, s.endFrameExclusive]) if (f > range.startFrame && f < range.endFrameExclusive) boundaries.add(f);
+  }
+  const ordered = [...boundaries].sort((a, b) => a - b);
+  const result: MediaSegment[] = [];
+  for (let i = 0; i < ordered.length - 1; i++) {
+    const startFrame = ordered[i]!, endFrameExclusive = ordered[i + 1]!;
+    const active = presents.filter(p => spans(p).some(s => s.startFrame <= startFrame && s.endFrameExclusive >= endFrameExclusive));
+    const e = active.length === 1 && active[0]!.elements.length === 1 ? active[0]!.elements[0] : undefined;
+    let media: VisualMediaElement | undefined;
+    if ((e?.kind === 'image' || e?.kind === 'video') && !e.parent && !e.animation && !e.attributes?.length
+      && (e.kind === 'image' ? !e.sampling && ['image/png', 'image/jpeg'].includes(e.artifact.mediaType) : e.artifact.mediaType === 'video/mp4' && frameRate)) {
+      const style = new Map(e.style.map(s => [s.name, s.value]));
+      const expected: Record<string, readonly (number | string)[]> = {
+        position: ['absolute'], inset: [0, '0', '0px'], left: [0, '0', '0px'], top: [0, '0', '0px'],
+        width: [`${composition.canvas.width}px`], height: [`${composition.canvas.height}px`],
+        'object-fit': ['fill'], opacity: [1, '1'],
+      };
+      if (style.size === e.style.length && ['position', 'width', 'height'].every(k => style.has(k)) && (style.has('inset') || (style.has('left') && style.has('top')))
+        && [...style].every(([k, v]) => expected[k]?.includes(v))) media = e;
+    }
+    let sourceStartFrame: number | undefined;
+    if (media?.kind === 'video') {
+      const sampling = media.sampling;
+      const sample = sampling?.segments.length === 1 ? sampling.segments[0] : undefined;
+      const localStart = startFrame - active[0]!.span.startFrame;
+      const localEnd = endFrameExclusive - active[0]!.span.startFrame;
+      if (!sampling) sourceStartFrame = localStart;
+      else if (sample && !sample.loop && sample.rate.numerator === sample.rate.denominator
+        && sample.sourceFrame.denominator === 1 && sample.target.startFrame <= localStart && sample.target.endFrameExclusive >= localEnd
+        && sampling.sourceFrameRate.numerator * frameRate!.denominator === frameRate!.numerator * sampling.sourceFrameRate.denominator) {
+        sourceStartFrame = sample.sourceFrame.numerator + localStart - sample.target.startFrame;
+      } else media = undefined;
+    }
+    const previous = result.at(-1);
+    if (previous && previous.media === media && media?.kind !== 'video') result[result.length - 1] = { ...previous, endFrameExclusive };
+    else result.push({ startFrame, endFrameExclusive, ...(media ? { media } : {}), ...(sourceStartFrame === undefined ? {} : { sourceStartFrame }) });
+  }
+  // Bound per-render work; pathological edits retain the original route.
+  return result.length > 128 ? [{ ...range }] : result;
+}
+
+export function mediaSegmentsEnvelope(composition: Composition, space: ProgramSpace, frameCount: number): string {
+  if (!planMediaSegments(composition, { startFrame: 0, endFrameExclusive: frameCount }, space.frameRate).some(s => s.media)) return '';
+  // Inert, portable metadata. The provider re-compiles and compares the ENTIRE
+  // document before trusting this hint; authored HTML cannot forge a fast path.
+  const json = JSON.stringify({ composition, space }).replaceAll('<', '\\u003c').replaceAll('>', '\\u003e');
+  return `${MEDIA_SEGMENTS_MARKER}${json}-->\n`;
+}
