+import { joinSegmentFiles } from './segment-join.js';
+import { createReadStream, createWriteStream } from 'node:fs';
+import { mkdtemp, readFile, writeFile, rm, stat, copyFile } from 'node:fs/promises';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+import { finished, pipeline } from 'node:stream/promises';
+import type { Composition } from '@hypit/composition';
+import type { ProgramSpace } from '@hypit/program-space';
+import { canonicalStringify } from '@hypit/protocol';
+import { compileHyperframesDocument, MEDIA_SEGMENTS_MARKER, planMediaSegments } from '@hypit/hyperframes';
+import { sealRenderedVisual } from '@hypit/media';
+import type { RenderedVisual } from '@hypit/media';
+import { isStreamingResourceStore } from '@hypit/runtime';
+import type { HyperframesVisualRequest } from '@hypit/render-hyperframes';
+import type { RenderHyperframesVisualOptions } from './render.js';
+import { runProcess } from './process.js';
+import { verifyOutput } from './output.js';
+
+/** Routes proven raster spans through FFmpeg, retaining absolute Hypit ranges.
+ * No network URLs or author paths enter FFmpeg; bytes come from the runtime's
+ * authorized, content-addressed Resource store. Audio remains in the graph mux.
+ */
+export async function renderMediaSegments(request: HyperframesVisualRequest, options: RenderHyperframesVisualOptions,
+  native: (request: HyperframesVisualRequest, options: RenderHyperframesVisualOptions) => Promise<RenderedVisual>,
+): Promise<RenderedVisual | undefined> {
+  if (process.env.HYPIT_MEDIA_SEGMENTS === '0') return undefined;
+  const { document } = request;
+  const marker = document.html.lastIndexOf(MEDIA_SEGMENTS_MARKER);
+  if (marker < 0 || !document.html.endsWith('-->\n')) return undefined;
+  let plan: ReturnType<typeof planMediaSegments>;
+  let sourceComposition: Composition;
+  let sourceSpace: ProgramSpace;
+  const range = request.range ?? { startFrame: 0, endFrameExclusive: document.frameCount };
+  try {
+    const { composition, space } = JSON.parse(document.html.slice(marker + MEDIA_SEGMENTS_MARKER.length, -4));
+    // A hint is never authority: compare dependencies, clock, canvas AND HTML.
+    if (canonicalStringify(compileHyperframesDocument(composition, space)) !== canonicalStringify(document)) return undefined;
+    plan = planMediaSegments(composition, range, document.frameRate);
+    sourceComposition = composition; sourceSpace = space;
+  } catch { return undefined; }
+  if (!plan.some(s => s.media)) return undefined;
+  const controller = new AbortController();
+  const signal = options.signal ? AbortSignal.any([options.signal, controller.signal]) : controller.signal;
+  const timeoutMs = options.processTimeoutMs ?? 30 * 60_000;
+  const timer = setTimeout(() => controller.abort(new Error('Segment render timed out')), timeoutMs);
+  let work: string | undefined;
+  const started = performance.now();
+  try {
+    signal.throwIfAborted();
+    work = await mkdtemp(join(tmpdir(), 'hypit-media-segments-'));
+    const ffmpeg = options.ffmpegPath ?? 'ffmpeg';
+    const maxOutputBytes = options.maxProcessOutputBytes ?? 4 * 1024 * 1024;
+    const maxBytes = options.maxRenderedBytes ?? 16 * 1024 * 1024 * 1024;
+    const fps = `${document.frameRate.numerator}/${document.frameRate.denominator}`;
+    const execute = (argv: string[]) => runProcess({ executable: ffmpeg, argv: ['-v', 'error', '-nostdin', '-y', ...argv], timeoutMs, maxOutputBytes, signal });
+    const read = async (artifact: RenderedVisual['artifact'], path: string) => {
+      if (isStreamingResourceStore(options.resources)) {
+        const stream = await options.resources.open(artifact.resource, { signal });
+        if (!stream) throw new Error('Segment resource is missing');
+        await pipeline(stream, createWriteStream(path), { signal });
+        if ((await stat(path)).size !== artifact.size) throw new Error('Segment resource size has changed');
+      } else {
+        if (artifact.size > (options.maxDecodedSourceBytes ?? 1024 * 1024 * 1024)) throw new Error('Segment input exceeds memory budget');
+        const bytes = await options.resources.get(artifact.resource, { signal });
+        if (!bytes || bytes.byteLength !== artifact.size) throw new Error('Segment resource is missing or has changed');
+        await writeFile(path, bytes, { signal });
+      }
+    };
+    const renderNative = async (segment: { startFrame: number; endFrameExclusive: number }) => {
+      // No browser programs are admitted by the planner. Remove inactive Presents
+      // so off-range videos cannot start loading/decoding during a native span.
+      const composition: Composition = { ...sourceComposition, tracks: sourceComposition.tracks.map(track => track.kind !== 'visual' ? track : {
+        ...track, presents: track.presents.filter(p => (p.visibility ?? [p.span]).some(s => s.startFrame < segment.endFrameExclusive && s.endFrameExclusive > segment.startFrame)),
+      }) };
+      return native({ document: compileHyperframesDocument(composition, sourceSpace), range: { startFrame: segment.startFrame, endFrameExclusive: segment.endFrameExclusive } }, { ...options, signal, onProgress: () => {} });
+    };
+    const clips: string[] = [];
+    let totalBytes = 0;
+    for (const [i, segment] of plan.entries()) {
+      signal.throwIfAborted();
+      const frames = segment.endFrameExclusive - segment.startFrame;
+      const output = join(work, `${i}.mp4`);
+      let mediaRendered = false;
+      if (segment.media) {
+        const input = join(work, `source-${i}`);
+        await read(segment.media.artifact, input);
+        // Reject non-raster bytes despite a forged MIME before starting a decoder.
+        if (segment.media.kind === 'video') {
+          const probe = await runProcess({ executable: options.ffprobePath ?? 'ffprobe',
+            argv: ['-v','error','-protocol_whitelist','file,pipe','-f','mov','-show_streams','-of','json',input], timeoutMs, maxOutputBytes, signal });
+          const streams = JSON.parse(Buffer.from(probe.stdout).toString()).streams;
+          const videos = streams.filter((s: { codec_type: string }) => s.codec_type === 'video');
+          const video = videos[0];
+          const start = segment.sourceStartFrame!;
+          const sameRate = (value: string) => {
+            const [n,d] = String(value).split('/').map(Number);
+            return Number.isSafeInteger(n) && Number.isSafeInteger(d) && d! > 0 && n! * document.frameRate.denominator === document.frameRate.numerator * d!;
+          };
+          if (videos.length === 1 && video.codec_name === 'h264' && video.pix_fmt === 'yuv420p'
+            && sameRate(video.avg_frame_rate) && sameRate(video.r_frame_rate)
+            && !video.side_data_list?.length && Number(video.nb_frames) >= start + frames) {
+            await execute(['-threads','1','-filter_threads','1','-protocol_whitelist','file,pipe','-f','mov','-i',input,
+              '-map','0:v:0','-vf', `trim=start_frame=${start}:end_frame=${start + frames},setpts=N*${document.frameRate.denominator}/(${document.frameRate.numerator}*TB),scale=${document.canvas.width}:${document.canvas.height}:flags=bicubic,setsar=1,format=yuv420p`,
+              '-r',fps,'-frames:v',String(frames),'-an','-c:v','libx264','-bf','0','-threads','1','-preset','fast',
+              '-crf', options.quality === 'high' ? '18' : options.quality === 'draft' ? '28' : '23',
+              '-video_track_timescale',String(document.frameRate.numerator * 1024),output]);
+            mediaRendered = true;
+          } else {
+            const visual = await renderNative(segment);
+            await read(visual.artifact, output);
+          }
+        } else {
+        if (segment.media.artifact.size > (options.maxDecodedSourceBytes ?? 1024 * 1024 * 1024)) throw new Error('Raster input exceeds memory budget');
+        const header = await readFile(input, { signal });
+        const png = header.subarray(0, 8).equals(Buffer.from([137,80,78,71,13,10,26,10]));
+        const jpeg = header[0] === 255 && header[1] === 216 && header[2] === 255;
+        if (!png && !jpeg) throw new Error('Segment source is not a PNG/JPEG raster');
+        // PNG colour types 4/6 and tRNS may carry transparency; retain native
+        // compositing until the media path implements the canvas clear colour.
+        if ((png && (header[25] === 4 || header[25] === 6 || ['tRNS', 'acTL', 'iCCP', 'eXIf'].some(chunk => header.includes(Buffer.from(chunk))))) || (jpeg && ['Exif', 'ICC_PROFILE'].some(chunk => header.includes(Buffer.from(chunk))))) {
+          const visual = await renderNative(segment);
+          await read(visual.artifact, output);
+        } else {
+        await execute(['-threads', '1', '-filter_threads', '1', '-loop', '1', '-framerate', fps,
+          '-protocol_whitelist', 'file,pipe', '-f', 'image2', '-c:v', png ? 'png' : 'mjpeg', '-i', input,
+          '-vf', `scale=${document.canvas.width}:${document.canvas.height}:flags=bicubic,setsar=1,format=yuv420p`,
+          '-frames:v', String(frames), '-an', '-c:v', 'libx264', '-bf', '0', '-threads', '1', '-preset', 'fast',
+          '-crf', options.quality === 'high' ? '18' : options.quality === 'draft' ? '28' : '23',
+          '-video_track_timescale', String(document.frameRate.numerator * 1024), output]);
+        mediaRendered = true;
+        }
+        }
+      } else {
+        const visual = await renderNative(segment);
+        await read(visual.artifact, output);
+      }
+      await verifyOutput({ path: output, document: { ...document, frameCount: frames }, ffprobePath: options.ffprobePath ?? 'ffprobe', timeoutMs, maxOutputBytes, signal });
+      totalBytes += (await stat(output)).size;
+      if (totalBytes > maxBytes) throw new Error('Segment output exceeds byte budget');
+      clips.push(output);
+      await options.onDiagnostic?.({ level: 'info', message: `Segment [${segment.startFrame},${segment.endFrameExclusive}): ${mediaRendered ? (segment.media!.kind === 'video' ? 'ffmpeg-video' : 'ffmpeg-raster') : 'hyperframes'}` });
+    }
+    const output = join(work, 'visual.mp4');
+    if (clips.length === 1) await copyFile(clips[0]!, output);
+    else await joinSegmentFiles({ files: clips, output, ffmpeg, width: document.canvas.width, height: document.canvas.height,
+      fps, frameCount: range.endFrameExclusive - range.startFrame, crf: options.quality === 'high' ? '18' : options.quality === 'draft' ? '28' : '23',
+      timeoutMs, maxOutputBytes, signal });
+    if ((await stat(output)).size > maxBytes) throw new Error('Joined output exceeds byte budget');
+    await verifyOutput({ path: output, document: { ...document, frameCount: range.endFrameExclusive - range.startFrame },
+      ffprobePath: options.ffprobePath ?? 'ffprobe', timeoutMs, maxOutputBytes, signal });
+    let artifact: RenderedVisual['artifact'];
+    if (isStreamingResourceStore(options.resources)) {
+      const stream = createReadStream(output, { signal });
+      const closed = finished(stream).catch(() => {});
+      try { artifact = await options.resources.putStream(stream, 'video/mp4', { signal }); }
+      finally { stream.destroy(); await closed; }
+    } else artifact = await options.resources.put(await readFile(output, { signal }), 'video/mp4', { signal });
+    signal.throwIfAborted();
+    options.onProgress?.({ phase: 'complete', frames: range.endFrameExclusive - range.startFrame, elapsedMs: performance.now() - started });
+    return sealRenderedVisual({ artifact, canvas: document.canvas, frameRate: document.frameRate, frameCount: range.endFrameExclusive - range.startFrame });
+  } finally {
+    clearTimeout(timer);
+    if (work) await rm(work, { recursive: true, force: true });
+  }
+}
