+import { spawn } from 'node:child_process';
+import { openProcessInput, processEnvironment } from './process.js';
+
+/** A single frame clock and bounded pipe, with one decoder alive at a time.
+ * Packet concat is unsafe across independently encoded H.264 GOPs/time bases.
+ */
+export async function joinSegmentFiles(args: {
+  files: readonly string[]; output: string; ffmpeg: string; width: number; height: number;
+  fps: string; frameCount: number; crf: string; timeoutMs: number; maxOutputBytes: number; signal: AbortSignal;
+}): Promise<void> {
+  const controller = new AbortController();
+  const signal = AbortSignal.any([args.signal, controller.signal]);
+  const encoder = openProcessInput({ executable: args.ffmpeg, timeoutMs: args.timeoutMs,
+    maxOutputBytes: args.maxOutputBytes, signal, argv: ['-v','error','-y','-filter_threads','1',
+      '-f','rawvideo','-pix_fmt','rgb24','-video_size',`${args.width}x${args.height}`,'-framerate',args.fps,'-i','pipe:0',
+      '-an','-c:v','libx264','-threads','1','-preset','fast','-crf',args.crf,
+      '-vf','scale=out_color_matrix=bt709:out_range=tv,format=yuv420p,setparams=color_primaries=bt709:color_trc=bt709:colorspace=bt709:range=tv',args.output],
+  });
+  void encoder.completed.catch(error => controller.abort(error));
+  let bytes = 0;
+  try {
+    for (const file of args.files) {
+      signal.throwIfAborted();
+      const child = spawn(args.ffmpeg, ['-v','error','-nostdin','-threads','1','-i',file,'-map','0:v:0',
+        '-an','-fps_mode','passthrough','-f','rawvideo','-pix_fmt','rgb24','-threads','1','pipe:1'],
+        { stdio: ['ignore','pipe','pipe'], env: processEnvironment(), shell: false });
+      let stderr = '';
+      let failure: Error | undefined;
+      const abort = () => { child.kill('SIGKILL'); };
+      signal.addEventListener('abort', abort, { once: true });
+      if (signal.aborted) abort();
+      const timer = setTimeout(() => { failure = new Error('Segment decode timed out'); abort(); }, args.timeoutMs);
+      child.stderr.on('data', (chunk: Buffer) => {
+        stderr += chunk.toString();
+        if (stderr.length > args.maxOutputBytes) { failure = new Error('Segment decoder diagnostics exceeded budget'); stderr = stderr.slice(-32_000); abort(); }
+      });
+      const closed = new Promise<void>((resolve, reject) => {
+        child.on('error', error => { failure = error; });
+        child.on('close', code => code === 0 && !failure ? resolve() : reject(failure ?? new Error(`Segment decoder exited ${code}: ${stderr}`)));
+      });
+      void closed.catch(() => {});
+      try {
+        for await (const chunk of child.stdout) { signal.throwIfAborted(); bytes += chunk.length; await encoder.write(chunk); }
+        await closed;
+      } finally {
+        clearTimeout(timer); signal.removeEventListener('abort', abort);
+        if (child.exitCode === null) child.kill('SIGKILL');
+        await closed.catch(() => {});
+      }
+    }
+    if (bytes !== args.frameCount * args.width * args.height * 3) throw new Error('Decoded segment frame count differs from requested range');
+    await encoder.close();
+  } catch (error) { controller.abort(error); throw error; }
+  finally { await encoder.completed.catch(() => {}); }
+}
