diff --git a/packages/studio/src/ui/studio-api.ts b/packages/studio/src/ui/studio-api.ts
new file mode 100644
--- /dev/null
+++ b/packages/studio/src/ui/studio-api.ts
@@ -0,0 +1,16 @@
+// studio-api.ts — deployment mount support (patch 0005): runtime Studio API
+// and asset URLs must carry the vite base prefix when the editor is mounted
+// under a per-session path (/studio/<sessionId>/ via HYPIT_STUDIO_BASE_PATH and
+// patch 0001's vite base). Root-relative "/__studio/*" literals resolve against
+// the host origin and never reach the session proxy in that topology.
+// Standalone (default base "/") keeps the exact upstream URLs.
+const runtimeBase = (import.meta as ImportMeta & { env?: { BASE_URL?: string } }).env?.BASE_URL ?? "/";
+// Callers pass root-relative paths ("/__studio/..."), so the base joins without
+// a trailing slash — keeping it yielded "//__studio/..." which the session
+// proxy's /__studio whitelist (and the child's strip middleware) refuses.
+const apiBase = runtimeBase === "" || runtimeBase === "/" ? "" : runtimeBase.replace(/\/+$/, "");
+
+/** Prefix a runtime Studio URL with the deployment base (standalone keeps it unchanged). */
+export function studioUrl(path: string): string {
+  return `${apiBase}${path}`;
+}

