+// Grassland engine bridge (task-107 patch 0000): under Node's permission model
+// (sandboxed author runner), reads outside the allowed scope throw
+// ERR_ACCESS_DENIED instead of reporting a missing file. A directory the
+// process may not search is not a package candidate; treat it as absent so
+// ancestor walks terminate instead of aborting the whole resolution.
+function readPackageJsonIfPermitted(path: string): string | undefined {
+  try {
+    return readFileSync(path, "utf8");
+  } catch (error) {
+    if (error !== null && typeof error === "object" && "code" in error) {
+      const code = String((error as { readonly code?: unknown }).code);
+      if (code === "ERR_ACCESS_DENIED" || code === "EACCES" || code === "ENOENT"
+        || code === "ENOTDIR") return undefined;
+    }
+    throw error;
+  }
+}
