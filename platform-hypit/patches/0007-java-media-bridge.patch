diff --git a/packages/provider-hyperframes-local/src/java-segment-bridge.ts b/packages/provider-hyperframes-local/src/java-segment-bridge.ts
new file mode 100644
--- /dev/null
+++ b/packages/provider-hyperframes-local/src/java-segment-bridge.ts
@@ -0,0 +1,57 @@
+import { readFile, writeFile, stat } from 'node:fs/promises';
+import type { RenderHyperframesVisualOptions } from './render.js';
+
+type SegmentSpecification = { kind: string; width: number; height: number; fpsNumerator: number;
+  fpsDenominator: number; frameCount: number; start: number; trimUnit: string; fit: string; crf: number };
+
+/** Keep existing native capabilities outside the shared Java contract. */
+function supportsJavaSegment(s: SegmentSpecification): boolean {
+  return [s.width, s.height, s.fpsNumerator, s.fpsDenominator, s.frameCount, s.start, s.crf].every(Number.isSafeInteger)
+    && ['image', 'video'].includes(s.kind) && ['frames', 'microseconds'].includes(s.trimUnit)
+    && ['fill', 'contain'].includes(s.fit) && s.width >= 2 && s.width <= 3840 && s.width % 2 === 0
+    && s.height >= 2 && s.height <= 3840 && s.height % 2 === 0
+    && s.fpsNumerator >= 1 && s.fpsNumerator <= 120000 && s.fpsDenominator >= 1 && s.fpsDenominator <= 10000
+    && s.fpsNumerator / s.fpsDenominator >= 1 && s.fpsNumerator / s.fpsDenominator <= 60
+    && s.frameCount >= 1 && s.frameCount <= 36000 && s.frameCount * s.fpsDenominator / s.fpsNumerator <= 600
+    && s.start >= 0 && s.start <= 86400000000 && (s.kind !== 'image' || s.start === 0)
+    && s.crf >= 0 && s.crf <= 40;
+}
+
+/** Internal server-to-server transport; profile/source documents carry no URL or credential. */
+export async function renderJavaSegment(input: string, output: string, specification: SegmentSpecification,
+  options: RenderHyperframesVisualOptions, signal: AbortSignal): Promise<boolean> {
+  const base = process.env.HYPIT_JAVA_MEDIA_URL;
+  if (!base) return false;
+  if (!supportsJavaSegment(specification)) {
+    await options.onDiagnostic?.({ level: 'info', message: 'Java segment specification limit: retaining local media route' });
+    return false;
+  }
+  if ((await stat(input)).size > 64 * 1024 * 1024) {
+    await options.onDiagnostic?.({ level: 'info', message: 'Java segment byte limit: retaining local media route' });
+    return false;
+  }
+  const token = process.env.HYPIT_INTERNAL_TOKEN;
+  if (!token || token.length < 32 || !options.mediaBridgeBuildId) throw new Error('Java media bridge requires trusted build identity and credential');
+  const url = new URL(`/internal/hypit/media-segments/${encodeURIComponent(options.mediaBridgeBuildId)}`, base);
+  const response = await fetch(url, { method: 'POST', redirect: 'error', signal,
+    headers: { authorization: `Bearer ${token}`, 'content-type': 'application/octet-stream', 'x-segment-spec': JSON.stringify(specification) },
+    body: new Uint8Array(await readFile(input, { signal })),
+  });
+  if (!response.ok) { await response.body?.cancel(); throw new Error(`Java media segment failed (${response.status})`); }
+  if (!response.body) throw new Error('Java media segment returned no media');
+  const chunks: Uint8Array[] = []; let size = 0;
+  const reader = response.body.getReader();
+  try {
+    while (true) {
+      signal.throwIfAborted();
+      const item = await reader.read(); if (item.done) break;
+      size += item.value.byteLength;
+      if (size > 64 * 1024 * 1024) throw new Error('Java media segment exceeds output budget');
+      chunks.push(item.value);
+    }
+  } finally { await reader.cancel(); reader.releaseLock(); }
+  if (size === 0) throw new Error('Java media segment returned empty media');
+  await writeFile(output, Buffer.concat(chunks), { signal });
+  await options.onDiagnostic?.({ level: 'info', message: `Java shared segment: ${response.headers.get('x-segment-cache') === 'hit' ? 'cache-hit' : 'rendered'}` });
+  return true;
+}
