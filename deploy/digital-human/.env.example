# 数字人部署环境样例（任务书 #105H C105H-01 / K10、K13.2）。
#
# 全部为非敏感占位：secret 一律是文件路径引用（值不进仓库/环境样例）；模型/供应商地址/
# key 不在此处——唯一来源是既有 AI 模型控制面（K14：治理台受信端点→凭据→模型/能力→价表，
# digital_human_render 复用该链路，不另建配置体系）。
#
# 默认值与 compose.production.yml 一致：全部关闭。启用序列见
# docs/运维/数字人工作台运行手册.md §部署；真实开放另需 dh_catalog 业务开关与 H03 门禁。

# ── 功能开关（默认全关；启用前三项须逐项确认）──────────────────────────────
# runtime 写路径总开关；false 时 internal 写路径 503 dh_runtime_unavailable，不派发 provider。
DH_ENABLED=false
# 真实第三方渲染/STT/TTS/LLM 出站（H03 真实门禁通过前保持 false——Fake 隔离测试不经此文件）。
DH_REAL_PROVIDERS_ENABLED=false
# Java 内部 mTLS 监听（9143）；打开须同时提供下方 TLS 三件套文件。
DH_INTERNAL_ENABLED=false
# frontend AI server(82) 的 DH 音频 WS 上游；置 dh-runtime:9080 才升级 WS，空=该路径 404。
DH_AUDIO_UPSTREAM=

# ── 端口契约（K13.2；内部 mTLS 端口只在容器网络，禁止发布到 0.0.0.0）─────────
DH_INTERNAL_PORT=9143
DH_RUNTIME_CONTROL_PORT=9443
DH_RUNTIME_AUDIO_PORT=9080

# ── mTLS 身份（K13.2：SAN 双向固定；证书生成/到期检测/轮换见运行手册）─────────
DH_INTERNAL_CLIENT_SAN=digital-human-runtime
DH_RUNTIME_CLIENT_SAN=intelligence-service
# 证书/secret 文件路径：模板留空（仓惯例），默认值见 compose.production.yml 的
# secrets 段（deploy/digital-human/secrets/，运维生成不入库）；启用时按实际路径填写。
DH_INTERNAL_TLS_CERT_FILE=
DH_INTERNAL_TLS_KEY_FILE=
DH_INTERNAL_TLS_CA_FILE=
DH_RUNTIME_MTLS_CERT_FILE=
DH_RUNTIME_MTLS_KEY_FILE=
# runtime→Java 内部通道基址（双向 TLS；K07.2）。
DH_JAVA_INTERNAL_BASE_URL=https://intelligence:9143

# ── 内容/资格 Redis（独立无持久化实例；K10：不复用既有业务 Redis 存用户正文）──
# 容器拓扑内固定 dh-redis:6379；容量满按 noeviction 拒写（错误可观测，fail closed）。
DH_CONTENT_REDIS_MAXMEMORY=256mb
DH_REDIS_CPU_LIMIT=0.50
DH_REDIS_MEMORY_LIMIT=320M

# ── 会话与来源（K10；初期 1 实例/1 并发，提高并发前先实测并更新 approved capacity）──
DH_MAX_SESSIONS_GLOBAL=1
# 允许的 AI 端点 origin（精确比对，逗号分隔；按实际域名替换占位）。
DH_ALLOWED_AI_ORIGINS=https://ai.example.org

# ── 媒体网关资源上限 ─────────────────────────────────────────────────────
DH_RUNTIME_CPU_LIMIT=2.00
DH_RUNTIME_MEMORY_LIMIT=1536M
DH_RUNTIME_CPU_RESERVATION=0.50
DH_RUNTIME_MEMORY_RESERVATION=256M

# ── TURN（K07：只短期资格 120 秒；长期 shared secret 绝不下发浏览器）─────────
# profile 门禁：`docker compose --profile dh-turn ...` 才创建 dh-turn 服务。
DH_TURN_CONF_FILE=./deploy/digital-human/turnserver.conf.example
DH_TURN_SECRET_FILE=
# 对外地址（公网 IP 或域名；conf 内 external-ip 同步）与端口——监听口 + 有界 relay 段。
DH_TURN_EXTERNAL_IP=203.0.113.10
DH_TURN_REALM=grassland
DH_TURN_LISTEN_PORT=3478
DH_TURN_RELAY_MIN=49160
DH_TURN_RELAY_MAX=49200
