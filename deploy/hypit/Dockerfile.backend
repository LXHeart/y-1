# Dockerfile.backend — C107-02 (task-107) trusted Hypit execution broker.
#
# Build context is the repository root. The image carries Node 24.14.1, the
# backend package and the patched engine build G; the broker is an internal
# service — only the Java intelligence service may reach its port.
FROM node:24.14.1-bookworm-slim

RUN apt-get update \
  && apt-get install -y --no-install-recommends ffmpeg ca-certificates git unzip chromium \
  && rm -rf /var/lib/apt/lists/*
# unzip：hyperframes 渲染浏览器（chrome-headless-shell zip）首次安装的解压依赖
# ——slim 基镜像不带，缺失时 build.submit 渲染 worker 报 "no zip archiver"。
# chromium：arm64 宿主上的原生渲染浏览器。chrome-for-testing 无 linux/arm64
# 构建，managed 浏览器会装 x86_64 二进制（rosetta 缺 x86_64 loader 必炸）；
# compose 层经 HYPIT_RENDER_CHROME_PATH 把 runtime profile 的 chromePath 指到
# 本包 /usr/bin/chromium（provider 契约内的用户自管浏览器路径）。

WORKDIR /app

# Backend package with its own lockfile (tsx only)
COPY platform-hypit/backend/package.json platform-hypit/backend/package-lock.json ./
RUN npm ci --omit=dev
COPY platform-hypit/backend/tsconfig.json ./

# 层序：引擎物化（重层）只依赖 upstream/patches/构建脚本——backend src 放到
# 其后，改 broker 源码不失效 pnpm install 缓存层。
COPY platform-hypit/upstream-manifest.json /app/platform-hypit/upstream-manifest.json
COPY platform-hypit/patches /app/platform-hypit/patches
COPY platform-hypit/upstream /app/platform-hypit/upstream
COPY scripts/acceptance/verify-107-upstream.sh /app/scripts/acceptance/verify-107-upstream.sh
COPY scripts/acceptance/build-107-engine.sh /app/scripts/acceptance/build-107-engine.sh
RUN bash scripts/acceptance/build-107-engine.sh --no-install \
  && corepack pnpm@10.33.0 install --frozen-lockfile --prefer-offline \
     --dir /app/platform-hypit/.generated/hypit

COPY platform-hypit/backend/src ./src
COPY platform-hypit/backend/scripts ./scripts

# 107-fix-2 C03（F03 修复）：模板资源与 catalog 显式进镜像——受控根
# /app/platform-hypit/{fixtures,templates}（§6.8 配置唯一表；D-03）。
# upstream manifest/固定树不变（仍由 verify-107-upstream.sh 校验）。
COPY platform-hypit/fixtures /app/platform-hypit/fixtures
COPY platform-hypit/templates /app/platform-hypit/templates

# Managed browser cache and uv program environments are mounted volumes, not
# baked into the image (they are large, machine-specific assets).
ENV HYPIT_BACKEND_HOST=0.0.0.0 \
    HYPIT_BACKEND_PORT=9240 \
    HYPIT_DATA_ROOT=/data/hypit \
    HYPIT_GENERATED_ROOT=/app/platform-hypit/.generated/hypit \
    HYPIT_FIXTURES_ROOT=/app/platform-hypit/fixtures \
    HYPIT_TEMPLATES_ROOT=/app/platform-hypit/templates

# 107-4 C09 实跑暴露：broker 容器 read_only:true——数据根的兄弟目录约定
# （dataRoot/../{projects,resources,runner-state,runner-tmp}，config.ts/server.ts）
# 要求父目录 /data 可写，只挂 /data/hypit 卷时运行时 mkdir 全被 EROFS 拒绝。
# 修复：状态伞 /data 整体挂卷（compose 层），镜像预建 /data 归运行 uid。
# socket/槽位卷根同理（supervisor 按命令在 broker 容器内写 /slots/<cmdId> 与
# /sockets/<cmdId>.sock）——空命名卷按镜像目录属主初始化，统一预建归 10001
# （compose 以 10001 运行 broker；曾 chown 给 node(uid 1000) 致 EACCES）。
RUN mkdir -p /data/hypit /sockets /slots \
  && chown -R 10001:10001 /data /sockets /slots /app
USER 10001

EXPOSE 9240
CMD ["node", "--import", "tsx", "src/main.mjs"]
