# Shared build stage: identical in both Dockerfiles so BuildKit can reuse it.
FROM node:24.14.1-bookworm-slim AS hypit-build
RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates git \
  && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY platform-hypit/backend/package.json platform-hypit/backend/package-lock.json ./
RUN npm ci --omit=dev
COPY platform-hypit/upstream-manifest.json /app/platform-hypit/upstream-manifest.json
COPY platform-hypit/patches /app/platform-hypit/patches
COPY platform-hypit/upstream /app/platform-hypit/upstream
COPY scripts/acceptance/verify-107-upstream.sh /app/scripts/acceptance/verify-107-upstream.sh
COPY scripts/acceptance/build-107-engine.sh /app/scripts/acceptance/build-107-engine.sh
RUN bash scripts/acceptance/build-107-engine.sh --no-install \
  && corepack pnpm@10.33.0 install --frozen-lockfile --prefer-offline \
     --dir /app/platform-hypit/.generated/hypit

# Keep the complete executable engine, including Studio and custom animation packages.
# Build inputs and package-manager caches do not enter the runtime image.
FROM node:24.14.1-bookworm-slim AS runtime
# Bootstrap TLS with the verified certificates installed in the build stage.
COPY --from=hypit-build /etc/ssl/certs/ /etc/ssl/certs/
RUN sed -i 's|http://deb.debian.org|https://deb.debian.org|g' /etc/apt/sources.list.d/debian.sources \
  && apt-get -o Acquire::Retries=2 -o Acquire::https::Timeout=30 update \
  && apt-get install -y --no-install-recommends ca-certificates git \
  && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=hypit-build --chown=10001:10001 /app/node_modules ./node_modules
COPY --from=hypit-build --chown=10001:10001 /app/platform-hypit/.generated/hypit /app/platform-hypit/.generated/hypit
COPY --from=hypit-build --chown=10001:10001 /app/platform-hypit/patches/manifest.json /app/platform-hypit/patches/manifest.json
COPY --chown=10001:10001 platform-hypit/backend/package.json platform-hypit/backend/package-lock.json ./
COPY --chown=10001:10001 platform-hypit/backend/src ./src
RUN mkdir -p /sockets /slots /runner-state \
  && chown -R 10001:10001 /sockets /slots /runner-state /home/node
ENV HYPIT_RUNNER_ROLE=isolated-author-runner

USER 10001
CMD ["node", "--import", "tsx", "src/runner/daemon.mjs", \
     "--socket", "/sockets/runner.sock", \
     "--distribution-root", "/app/platform-hypit/.generated/hypit", \
     "--slot-root", "/slots", \
     "--state-home", "/runner-state", \
     "--tmp", "/tmp"]
