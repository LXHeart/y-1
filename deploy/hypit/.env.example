# .env.example — 任务书 #107-3 C107-23 首建；107-fix-2 C02 增补。
#
# 复制为 .env 后按需修改；带 `:?` 语义的变量在启用 hypit profile 时必填。
# 本文件不得包含任何真实凭据（secret-scan 门禁）。
#
# 107-fix-2：生产组合/启停统一走 scripts/acceptance/hypit-compose.sh（固定
# overlay 次序 base→production→DH→hypit[→full]；默认 fail-closed；--enable-hypit
# 显式启用并预检密钥）。不要再手工拼 -f 列表启动共享服务（F01 教训）。

# ── 业务开关 ─────────────────────────────────────────────────────────────
# intelligence 业务可用性总闸；false 时 Hypit API 面 fail-closed（403/503）。
HYPIT_ENABLED=false

# 可信 Java/host ↔ broker 内部令牌：无默认，启用时必须非空（>=32 字符）。
# 绝不传给 author runner（K10.4）。凭据不入仓库。
# HYPIT_INTERNAL_TOKEN=

# operator 账号（uuid 逗号分隔）；默认空=无 operator 写权限面。
# HYPIT_OPERATOR_ACCOUNT_IDS=

# ── broker 连接（容器内部）───────────────────────────────────────────────
# intelligence → hypit-backend；端口固定 9240（实现落地值，§13.3 登记）。
HYPIT_SIDECAR_BASE_URL=http://hypit-backend:9240

# ── 数据根（volume）──────────────────────────────────────────────────────
HYPIT_DATA_ROOT=/data/hypit
HYPIT_HOST_STATE_ROOT=/data/hypit/host

# ── Studio 会话 ──────────────────────────────────────────────────────────
# nginx Studio 反代上游：禁用=空（片段对空上游一律 404）；启用=hypit-backend:9240
# （由 hypit-compose.sh --enable-hypit 显式注入；§6.8 配置唯一表）。
HYPIT_STUDIO_UPSTREAM=

# Studio 签票密钥（F04）：无生产默认，启用时必须 ≥32 字符；
# hypit-compose.sh --enable-hypit 预检强制，缺项/过短不执行任何 docker 变更。
# HYPIT_STUDIO_TICKET_SECRET=
HYPIT_STUDIO_MAX_SESSIONS=2
HYPIT_STUDIO_IDLE_SECONDS=1800
HYPIT_STUDIO_TTL_SECONDS=28800

# ── Capture 表面（107-fix-1 D-07）────────────────────────────────────────
# capture.screenshot / capture.run 的 Chrome 缓存根：空=未部署（三 capture kind
# 一律 409 capture_not_configured，不静默降级），配置=启用（启用前需先经
# capture.install-browser 预装固定版本 153.0.8010.12，never latest）。
# full 变体示例值指向共享 browsers 卷子目录（见 compose.full.yml 注释示例）。
# HYPIT_CAPTURE_BROWSER_CACHE=/data/hypit/browsers/capture

# ── 上限（Java + nginx + sidecar 三方一致）────────────────────────────────
HYPIT_MAX_UPLOAD_BYTES=524288000
HYPIT_MAX_PROJECT_ARCHIVE_BYTES=1073741824
HYPIT_MAX_PROJECT_EXPANDED_BYTES=4294967296
HYPIT_PREVIEW_TTL_SECONDS=1800

# ── 镜像（可选覆盖；默认按 deploy/hypit/Dockerfile.* 构建）────────────────
# HYPIT_BACKEND_IMAGE=grassland/hypit-backend:latest
# HYPIT_RUNNER_IMAGE=grassland/hypit-runner:latest
