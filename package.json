{
  "name": "douyin-video-page",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "config": {
    "//": "本地 postgres（docker-compose 的 postgres-local）宿主机侧地址——容器服务名在宿主机不可解析",
    "localDbUrl": "postgresql://grassland:grassland@localhost:55432/grassland"
  },
  "scripts": {
    "dev": "concurrently \"npm run dev:client\" \"npm run dev:server\"",
    "dev:client": "vite",
    "dev:server": "tsx watch server/src/index.ts",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vue-tsc && vite build",
    "build:server": "tsc -p server/tsconfig.json",
    "preview": "vite preview",
    "start": "node server/dist/index.js",
    "typecheck": "vue-tsc --noEmit && tsc -p server/tsconfig.json --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:coverage": "vitest run --config vitest.config.ts --coverage",
    "coverage:changed": "tsx server/src/scripts/check-changed-coverage.ts",
    "security:secrets": "tsx server/src/scripts/check-tracked-secrets.ts",
    "e2e": "playwright test --config=playwright.config.ts",
    "e2e:ci": "bash scripts/ci-e2e.sh",
    "e2e:seed:auth": "tsx scripts/e2e-auth-seed.ts",
    "db:migrate": "tsx server/src/scripts/run-migrations.ts",
    "db:migrate:local": "DATABASE_URL=$npm_package_config_localDbUrl tsx server/src/scripts/run-migrations.ts",
    "e2e:seed": "DATABASE_URL=$npm_package_config_localDbUrl tsx scripts/e2e-seed.ts",
    "admin:create": "tsx server/src/scripts/create-admin.ts"
  },
  "dependencies": {
    "@types/express-session": "^1.18.2",
    "@types/multer": "^2.1.0",
    "@types/pg": "^8.15.5",
    "bcryptjs": "^3.0.3",
    "cheerio": "^1.1.2",
    "connect-pg-simple": "^10.0.0",
    "cors": "^2.8.5",
    "dompurify": "^3.4.13",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-session": "^1.19.0",
    "marked": "^18.0.9",
    "multer": "^2.1.1",
    "nodemailer": "9.0.4",
    "pg": "^8.20.0",
    "pino": "^10.0.0",
    "pino-http": "^11.0.0",
    "playwright": "1.59.1",
    "vue": "^3.5.22",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@playwright/test": "1.59.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.6.1",
    "@types/nodemailer": "^8.0.0",
    "@types/supertest": "^7.2.0",
    "@vitejs/plugin-vue": "6.0.8",
    "@vitest/coverage-v8": "3.2.7",
    "@vue/test-utils": "^2.4.11",
    "concurrently": "^9.2.1",
    "happy-dom": "^20.11.1",
    "supertest": "^7.2.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "7.3.6",
    "vitest": "3.2.7",
    "vue-tsc": "^2.2.12"
  }
}
