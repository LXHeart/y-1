{
  "name": "douyin-video-page",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "config": {
    "//": "本地 postgres（docker-compose 的 postgres-local）宿主机侧地址——容器服务名在宿主机不可解析",
    "localDbUrl": "postgresql://grassland:grassland@localhost:55432/grassland"
  },
  "scripts": {
    "dev": "npm run dev:client",
    "dev:client": "vite",
    "build": "npm run build:client",
    "build:client": "vue-tsc && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint src tests scripts test",
    "test": "vitest run --config vitest.config.ts",
    "test:coverage": "vitest run --config vitest.config.ts --coverage",
    "coverage:changed": "tsx scripts/quality/check-changed-coverage.ts",
    "docs:status": "tsx scripts/quality/check-doc-status.ts",
    "security:secrets": "node --import tsx scripts/security/check-tracked-secrets.ts",
    "e2e": "playwright test --config=playwright.config.ts",
    "e2e:ci": "bash scripts/ci-e2e.sh",
    "e2e:seed:auth": "tsx scripts/e2e-auth-seed.ts",
    "e2e:seed": "DATABASE_URL=$npm_package_config_localDbUrl tsx scripts/e2e-seed.ts"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "bcryptjs": "^3.0.3",
    "dompurify": "^3.4.13",
    "marked": "^18.0.9",
    "pg": "^8.20.0",
    "pinia": "^4.0.2",
    "qrcode": "^1.5.4",
    "vue": "^3.5.22",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.59.1",
    "@types/node": "^24.6.1",
    "@types/pg": "^8.15.5",
    "@types/qrcode": "^1.5.5",
    "@vitejs/plugin-vue": "6.0.8",
    "@vitest/coverage-v8": "3.2.7",
    "@vue/test-utils": "^2.4.11",
    "esbuild": "^0.28.2",
    "eslint": "^10.8.1",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.11.0",
    "happy-dom": "^20.11.1",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vite": "7.3.6",
    "vitest": "3.2.7",
    "vue-tsc": "^2.2.12"
  }
}
