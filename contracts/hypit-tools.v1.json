{
  "format": "y1.hypit-tools@1",
  "version": "3.3.0",
  "invocation": {
    "endpoint": "/api/hypit/projects/{projectId}/tools/{tool}",
    "envelope": "AcceptedJob",
    "unknownAction": {
      "http": 400,
      "code": "hypit_unsupported_action"
    }
  },
  "tools": [
    {
      "id": "media.probe",
      "upstreamEntry": "packages/video-cli/src/media.ts#mediaProbe",
      "executionClass": "local-fs",
      "permission": "owner",
      "sideEffects": false,
      "costClass": "free",
      "input": {
        "assetId": "uuid"
      },
      "output": {
        "durationSeconds": "number",
        "streams": "object[]",
        "frameRate": "{numerator,denominator}?",
        "sizeBytes": "number",
        "hasAudio": "boolean"
      },
      "sourceArguments": [
        {
          "argument": "--json",
          "status": "exposed"
        }
      ],
      "testCases": [
        "probe silent-cuts returns 6s/30fps/no-audio",
        "multi-stream keeps attached_pic visible"
      ]
    },
    {
      "id": "media.cut",
      "upstreamEntry": "packages/video-cli/src/media.ts#mediaCut",
      "executionClass": "local-fs",
      "permission": "owner",
      "sideEffects": true,
      "costClass": "free",
      "input": {
        "assetId": "uuid",
        "start": "seconds>=0",
        "end": "seconds>start",
        "labelTime?": "boolean"
      },
      "output": {
        "outputs": "[{assetId,role,mediaType,summary}]"
      },
      "sourceArguments": [
        {
          "argument": "--at/--range",
          "status": "exposed"
        }
      ],
      "testCases": [
        "cut 0-3s of silent-cuts probes 3s"
      ]
    },
    {
      "id": "media.frames",
      "upstreamEntry": "packages/video-cli/src/media-frames.ts",
      "executionClass": "local-fs",
      "permission": "owner",
      "sideEffects": true,
      "costClass": "free",
      "input": {
        "assetId": "uuid",
        "oneOf": [
          "at[]",
          "start+end+every"
        ]
      },
      "output": {
        "frames": "[{assetId,timestampSeconds}]"
      },
      "sourceArguments": [
        {
          "argument": "--every-frame",
          "status": "exposed"
        }
      ],
      "testCases": [
        "mutually exclusive at vs range rejected 400",
        "everyFrame timestamps strictly increasing"
      ]
    },
    {
      "id": "media.tile",
      "upstreamEntry": "packages/video-cli/src/frame-grid.ts",
      "executionClass": "local-fs",
      "permission": "owner",
      "sideEffects": true,
      "costClass": "free",
      "input": {
        "assetId": "uuid",
        "oneOf": [
          "range",
          "ranges[]"
        ],
        "every?": "number",
        "columns?": "int",
        "rows?": "int",
        "cell?": "object",
        "transcriptAssetId?": "uuid",
        "around?": "string",
        "occurrence?": "int",
        "padding?": "seconds"
      },
      "output": {
        "grids": "[{assetId,frames:[{timestampSeconds}]}]"
      },
      "sourceArguments": [
        {
          "argument": "--transcript",
          "status": "exposed"
        }
      ],
      "testCases": [
        "around second occurrence selects correct interval",
        "pagination no gaps no repeats"
      ]
    },
    {
      "id": "media.tiles",
      "upstreamEntry": "packages/video-cli/src/frame-grid.ts#paged",
      "executionClass": "local-fs",
      "permission": "owner",
      "sideEffects": true,
      "costClass": "free",
      "input": {
        "assetId": "uuid",
        "ranges[]": "object[]",
        "cursor?": "string"
      },
      "output": {
        "items": "[{assetId}]",
        "nextCursor": "string?"
      },
      "sourceArguments": [
        {
          "argument": "--page",
          "status": "exposed"
        }
      ],
      "testCases": [
        "two ranges paginate without overlap"
      ]
    },
    {
      "id": "media.boundaries",
      "upstreamEntry": "packages/video-cli/src/media.ts#boundaries",
      "executionClass": "local-fs",
      "permission": "owner",
      "sideEffects": false,
      "costClass": "free",
      "input": {
        "assetId": "uuid",
        "thresholds?": "object"
      },
      "output": {
        "boundaries": "[{timeSeconds,score}]"
      },
      "sourceArguments": [
        {
          "argument": "--json",
          "status": "exposed"
        }
      ],
      "testCases": [
        "boundaries are observations, not semantic shots"
      ]
    },
    {
      "id": "media.fetch",
      "upstreamEntry": "packages/yt-dlp/src/#fetch",
      "executionClass": "network-fetch",
      "permission": "owner",
      "sideEffects": true,
      "costClass": "free",
      "input": {
        "url": "http(s) URL"
      },
      "output": {
        "outputs": "[{assetId,role,mediaType,summary}]"
      },
      "sourceArguments": [
        {
          "argument": "positional url",
          "status": "exposed"
        }
      ],
      "testCases": [
        "fixture local-http download probes",
        "redirect to denied host rejected"
      ]
    },
    {
      "id": "media.prepare-fetch",
      "upstreamEntry": "packages/yt-dlp/src/#prepare",
      "executionClass": "local-fs",
      "permission": "operator",
      "sideEffects": true,
      "costClass": "free",
      "input": {},
      "output": {
        "status": "string",
        "logPath": "string"
      },
      "sourceArguments": [
        {
          "argument": "--prepare",
          "status": "serverManaged"
        }
      ],
      "testCases": [
        "missing environment reports preparation without secrets"
      ]
    },
    {
      "id": "speech.transcribe",
      "upstreamEntry": "packages/video-cli/src/speech.ts + provider-whisperx-local",
      "executionClass": "remote-or-local-model",
      "permission": "owner+grant",
      "sideEffects": true,
      "costClass": "authorized-external",
      "input": {
        "assetId": "uuid",
        "language": "bcp47"
      },
      "output": {
        "words": "[{text,start,end}]",
        "rawEvidence": "handle"
      },
      "sourceArguments": [
        {
          "argument": "--language",
          "status": "exposed"
        }
      ],
      "testCases": [
        "zh/en fixtures produce monotonic word times",
        "silence yields empty result not fabricated text"
      ]
    },
    {
      "id": "speech.measure",
      "upstreamEntry": "packages/estimate",
      "executionClass": "in-process",
      "permission": "owner",
      "sideEffects": false,
      "costClass": "free",
      "input": {
        "text": "string<=20000",
        "language": "bcp47",
        "oneOf": [
          "pace",
          "rate"
        ],
        "rounding?": "string",
        "padding?": "seconds"
      },
      "output": {
        "estimated": true,
        "durationSeconds": "number",
        "basis": "string"
      },
      "sourceArguments": [
        {
          "argument": "--language",
          "status": "exposed"
        }
      ],
      "testCases": [
        "estimate flagged estimated; ffprobe duration not overwritten"
      ]
    },
    {
      "id": "speech.align",
      "upstreamEntry": "packages/speech-alignment + packages/video-cli/src/speech.ts#align",
      "executionClass": "in-process",
      "permission": "owner",
      "sideEffects": false,
      "costClass": "free",
      "input": {
        "evidence": "object (speech.transcribe result)",
        "script": "object[] (Segment/SemanticTake)",
        "compensation?": "object",
        "takeAdjustments?": "object[]"
      },
      "output": {
        "format": "y1.hypit.speech-align@1",
        "segments": "object[]",
        "note": "string"
      },
      "sourceArguments": [
        {
          "argument": "--align",
          "status": "exposed"
        }
      ],
      "testCases": [
        "word evidence aligns script segments; native normalize/alignWordGroups untouched"
      ]
    },
    {
      "id": "image.transform",
      "upstreamEntry": "packages/provider-image-opencv-local#raster_execute",
      "executionClass": "local-model",
      "permission": "owner",
      "sideEffects": true,
      "costClass": "free",
      "input": {
        "assetId": "uuid",
        "operations[]": "raster 词表闭合集 [{kind,...}]"
      },
      "output": {
        "outputs": "[{assetId,role,mediaType}]"
      },
      "sourceArguments": [
        {
          "argument": "raster request JSON",
          "status": "exposed"
        }
      ],
      "testCases": [
        "unknown op rejected 400 (closed vocabulary)",
        "encode tail decides artifact media type"
      ]
    },
    {
      "id": "image.compose",
      "upstreamEntry": "packages/provider-image-opencv-local#raster_execute",
      "executionClass": "local-model",
      "permission": "owner",
      "sideEffects": true,
      "costClass": "free",
      "input": {
        "assetId": "uuid",
        "layers[]": "object[]",
        "operations[]": "raster 词表闭合集"
      },
      "output": {
        "outputs": "[{assetId,role,mediaType}]"
      },
      "sourceArguments": [
        {
          "argument": "raster request JSON",
          "status": "exposed"
        }
      ],
      "testCases": [
        "compose stages multiple source layers then operations"
      ]
    },
    {
      "id": "snapshot",
      "upstreamEntry": "packages/video-cli/src/snapshot.ts + studio preview render",
      "executionClass": "browser",
      "permission": "owner-session",
      "sideEffects": true,
      "costClass": "free",
      "input": {
        "previewSessionId": "uuid",
        "oneOf": [
          "at[]",
          "ranges[]"
        ],
        "pageSize?": "int<=50"
      },
      "output": {
        "frames": "[{assetId,frameIndex}]",
        "pages": "number"
      },
      "sourceArguments": [
        {
          "argument": "--at/--ranges",
          "status": "exposed"
        }
      ],
      "testCases": [
        "URLs/ports generated server-side; browser cannot name internal URLs",
        "no new export Build"
      ]
    },
    {
      "id": "capture.screenshot",
      "upstreamEntry": "packages/browser-capture/src/#screenshot",
      "executionClass": "browser",
      "permission": "owner",
      "sideEffects": true,
      "costClass": "free",
      "input": {
        "url": "http(s) URL",
        "viewport?": "object",
        "selector?": "string",
        "waitFor?": "load|domcontentloaded|networkidle",
        "fullPage?": "boolean",
        "format?": "string"
      },
      "output": {
        "outputs": "[{assetId,role:'footage',mediaType}]"
      },
      "sourceArguments": [
        {
          "argument": "--viewport",
          "status": "exposed"
        }
      ],
      "testCases": [
        "local-web fixture pixels captured at chosen scale",
        "url-policy denied target → 400 hypit_url_denied, zero egress"
      ]
    },
    {
      "id": "capture.run",
      "upstreamEntry": "packages/browser-capture/src/#run",
      "executionClass": "browser",
      "permission": "owner",
      "sideEffects": true,
      "costClass": "free",
      "input": {
        "projectId": "uuid",
        "scriptPath": "workspace-relative",
        "args?": "string[]<=16",
        "timeoutMs?": "1..120000"
      },
      "output": {
        "outputs": "[{assetId}]"
      },
      "sourceArguments": [
        {
          "argument": "positional script",
          "status": "exposed"
        }
      ],
      "testCases": [
        "script must belong to current project head; host scripts rejected",
        "network denied by default; outputs stay in the session root"
      ]
    },
    {
      "id": "capture.install-browser",
      "upstreamEntry": "packages/browser-capture/src/#install",
      "executionClass": "local-fs",
      "permission": "operator",
      "sideEffects": true,
      "costClass": "free",
      "input": {},
      "output": {
        "version": "string"
      },
      "sourceArguments": [
        {
          "argument": "--version",
          "status": "serverManaged"
        }
      ],
      "testCases": [
        "fixed capture Chrome 153.0.8010.12; never latest"
      ]
    },
    {
      "id": "packages.build",
      "upstreamEntry": "packages/video-cli/src/package-selection.ts + compiler",
      "executionClass": "runner-isolated",
      "permission": "owner",
      "sideEffects": true,
      "costClass": "free",
      "input": {
        "projectPackagePath": "workspace-relative",
        "revision?": "bigint"
      },
      "output": {
        "tarballHandle": "string",
        "diagnostics": "object[]"
      },
      "sourceArguments": [
        {
          "argument": "positional path",
          "status": "exposed"
        }
      ],
      "testCases": [
        "arbitrary user cmd rejected; compile output is a tarball"
      ]
    },
    {
      "id": "packages.pack",
      "upstreamEntry": "pack pipeline",
      "executionClass": "runner-isolated",
      "permission": "owner",
      "sideEffects": true,
      "costClass": "free",
      "input": {
        "projectPackagePath": "workspace-relative"
      },
      "output": {
        "packageHandle": "string"
      },
      "sourceArguments": [
        {
          "argument": "--pack",
          "status": "serverManaged"
        }
      ],
      "testCases": [
        "packed artifact restorable in a fresh directory"
      ]
    },
    {
      "id": "packages.install",
      "upstreamEntry": "host package install",
      "executionClass": "local-fs",
      "permission": "operator",
      "sideEffects": true,
      "costClass": "free",
      "input": {
        "specifier": "name@exactVersion",
        "scope": "project|host",
        "projectId?": "uuid"
      },
      "output": {
        "status": "string"
      },
      "sourceArguments": [
        {
          "argument": "positional specifier",
          "status": "exposed"
        }
      ],
      "testCases": [
        "latest and ranges rejected; vendor namespace cannot be overridden"
      ]
    },
    {
      "id": "packages.status",
      "upstreamEntry": "host package inspect",
      "executionClass": "local-fs",
      "permission": "operator",
      "sideEffects": false,
      "costClass": "free",
      "input": {
        "specifier?": "name@exactVersion"
      },
      "output": {
        "packages": "[{name,version,ready}]"
      },
      "sourceArguments": [
        {
          "argument": "--status",
          "status": "serverManaged"
        }
      ],
      "testCases": [
        "native status semantics preserved"
      ]
    }
  ],
  "agentInvocation": {
    "endpoint": "agent job checkpoint actions（planner 可见集经 /agent-jobs 创建，非直接 HTTP 工具端点）",
    "registry": "platform-java/.../hypit/agent/HypitAgentToolRegistry.java",
    "visibilityRule": "可见工具集合 == 实际 handler 集合；scope ∩ 注册表登记集才进 planner（HypitAgentScope.confinedTo）",
    "typeFidelity": "number/boolean/object/array 参数保持 JSON 原始类型，禁止字符串化；逐工具 schema 校验失败返回结构化结果",
    "actionRow": "工具名存 hypit_job_action.input_json.tool，kind 列恒为受限枚举（llm/tool/apply/approval/review）",
    "unknownTool": {
      "code": "hypit_unsupported_action",
      "http": "n/a（动作行结构化失败，非 501）"
    }
  },
  "agentTools": [
    {
      "id": "knowledge.search",
      "category": "knowledge",
      "input": {
        "query": "string?",
        "topic": "string?",
        "limit": "number?"
      },
      "notes": "真实知识索引检索（HypitKnowledgeService.search）"
    },
    {
      "id": "knowledge.read",
      "category": "knowledge",
      "input": {
        "path": "string"
      },
      "notes": "读取知识文档原文（HypitKnowledgeService.read）"
    },
    {
      "id": "build.status",
      "category": "build",
      "input": {
        "buildId": "uuid"
      },
      "notes": "本工程 Build 状态（HypitBuildRepository，跨工程 404）"
    },
    {
      "id": "build.submit",
      "category": "build",
      "input": {
        "planId": "uuid",
        "title": "string?",
        "grantId": "uuid?"
      },
      "notes": "提交构建（HypitBuildService.submit；幂等键自 (jobId,tool,input) 派生）"
    },
    {
      "id": "build.cancel",
      "category": "build",
      "input": {
        "buildId": "uuid",
        "reason": "string?"
      },
      "notes": "取消构建（HypitBuildService.cancel；终态重复取消零副作用）"
    },
    {
      "id": "output.archive",
      "category": "build",
      "input": {
        "outputId": "uuid"
      },
      "notes": "产物归档（HypitArchiveService.archiveOutput；已归档回现状）"
    },
    {
      "id": "mutation.apply",
      "category": "mutation",
      "input": {
        "changes": "array<{path,action,content?,baseHash?}>",
        "applyMode": "string?(save|validated)"
      },
      "notes": "写回变更集（HypitChangesetService create+apply；baseRevision 取 job checkpoint 权威值）"
    },
    {
      "id": "packages.build",
      "category": "assets",
      "input": {
        "freeform": "object"
      },
      "notes": "工程包构建（HypitAssetService.runTool → tool.run job → runner）"
    },
    {
      "id": "packages.pack",
      "category": "assets",
      "input": {
        "freeform": "object"
      },
      "notes": "工程包打包（同上，真实工具提交链）"
    },
    {
      "id": "snapshot",
      "category": "assets",
      "input": {
        "freeform": "object"
      },
      "notes": "审片/取证快照（同上，真实工具提交链）"
    },
    {
      "id": "feedback.mutate",
      "category": "feedback",
      "input": {
        "mutations": "array",
        "run": "string?",
        "expectedHash": "string?"
      },
      "notes": "审片评论整批原子修改（sidecar feedback.mutate；CAS 冲突结构化 409）"
    }
  ]
}
