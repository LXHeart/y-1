{
  "format": "y1.hypit-tools@1",
  "version": "3.1.0",
  "invocation": {
    "endpoint": "/api/hypit/projects/{projectId}/tools/{tool}",
    "envelope": "AcceptedJob",
    "unknownAction": { "http": 400, "code": "hypit_unsupported_action" }
  },
  "tools": [
    {
      "id": "media.probe",
      "upstreamEntry": "packages/video-cli/src/media.ts#mediaProbe",
      "executionClass": "local-fs",
      "permission": "owner",
      "sideEffects": false,
      "costClass": "free",
      "input": { "assetId": "uuid" },
      "output": { "durationSeconds": "number", "streams": "object[]", "frameRate": "{numerator,denominator}?", "sizeBytes": "number", "hasAudio": "boolean" },
      "sourceArguments": [{ "argument": "--json", "status": "exposed" }],
      "testCases": ["probe silent-cuts returns 6s/30fps/no-audio", "multi-stream keeps attached_pic visible"]
    },
    {
      "id": "media.cut",
      "upstreamEntry": "packages/video-cli/src/media.ts#mediaCut",
      "executionClass": "local-fs",
      "permission": "owner",
      "sideEffects": true,
      "costClass": "free",
      "input": { "assetId": "uuid", "start": "seconds>=0", "end": "seconds>start", "labelTime?": "boolean" },
      "output": { "outputs": "[{assetId,role,mediaType,summary}]" },
      "sourceArguments": [{ "argument": "--at/--range", "status": "exposed" }],
      "testCases": ["cut 0-3s of silent-cuts probes 3s"]
    },
    {
      "id": "media.frames",
      "upstreamEntry": "packages/video-cli/src/media-frames.ts",
      "executionClass": "local-fs",
      "permission": "owner",
      "sideEffects": true,
      "costClass": "free",
      "input": { "assetId": "uuid", "oneOf": ["at[]", "start+end+every"] },
      "output": { "frames": "[{assetId,timestampSeconds}]" },
      "sourceArguments": [{ "argument": "--every-frame", "status": "exposed" }],
      "testCases": ["mutually exclusive at vs range rejected 400", "everyFrame timestamps strictly increasing"]
    },
    {
      "id": "media.tile",
      "upstreamEntry": "packages/video-cli/src/frame-grid.ts",
      "executionClass": "local-fs",
      "permission": "owner",
      "sideEffects": true,
      "costClass": "free",
      "input": { "assetId": "uuid", "oneOf": ["range", "ranges[]"], "every?": "number", "columns?": "int", "rows?": "int", "cell?": "object", "transcriptAssetId?": "uuid", "around?": "string", "occurrence?": "int", "padding?": "seconds" },
      "output": { "grids": "[{assetId,frames:[{timestampSeconds}]}]" },
      "sourceArguments": [{ "argument": "--transcript", "status": "exposed" }],
      "testCases": ["around second occurrence selects correct interval", "pagination no gaps no repeats"]
    },
    {
      "id": "media.tiles",
      "upstreamEntry": "packages/video-cli/src/frame-grid.ts#paged",
      "executionClass": "local-fs",
      "permission": "owner",
      "sideEffects": true,
      "costClass": "free",
      "input": { "assetId": "uuid", "ranges[]": "object[]", "cursor?": "string" },
      "output": { "items": "[{assetId}]", "nextCursor": "string?" },
      "sourceArguments": [{ "argument": "--page", "status": "exposed" }],
      "testCases": ["two ranges paginate without overlap"]
    },
    {
      "id": "media.boundaries",
      "upstreamEntry": "packages/video-cli/src/media.ts#boundaries",
      "executionClass": "local-fs",
      "permission": "owner",
      "sideEffects": false,
      "costClass": "free",
      "input": { "assetId": "uuid", "thresholds?": "object" },
      "output": { "boundaries": "[{timeSeconds,score}]" },
      "sourceArguments": [{ "argument": "--json", "status": "exposed" }],
      "testCases": ["boundaries are observations, not semantic shots"]
    },
    {
      "id": "media.fetch",
      "upstreamEntry": "packages/yt-dlp/src/#fetch",
      "executionClass": "network-fetch",
      "permission": "owner",
      "sideEffects": true,
      "costClass": "free",
      "input": { "url": "http(s) URL" },
      "output": { "outputs": "[{assetId,role,mediaType,summary}]" },
      "sourceArguments": [{ "argument": "positional url", "status": "exposed" }],
      "testCases": ["fixture local-http download probes", "redirect to denied host rejected"]
    },
    {
      "id": "media.prepare-fetch",
      "upstreamEntry": "packages/yt-dlp/src/#prepare",
      "executionClass": "local-fs",
      "permission": "operator",
      "sideEffects": true,
      "costClass": "free",
      "input": {},
      "output": { "status": "string", "logPath": "string" },
      "sourceArguments": [{ "argument": "--prepare", "status": "serverManaged" }],
      "testCases": ["missing environment reports preparation without secrets"]
    },
    {
      "id": "transcribe",
      "upstreamEntry": "packages/video-cli/src/speech.ts + provider-whisperx-local",
      "executionClass": "remote-or-local-model",
      "permission": "owner+grant",
      "sideEffects": true,
      "costClass": "authorized-external",
      "input": { "assetId": "uuid", "language": "bcp47" },
      "output": { "words": "[{text,start,end}]", "rawEvidence": "handle" },
      "sourceArguments": [{ "argument": "--language", "status": "exposed" }],
      "testCases": ["zh/en fixtures produce monotonic word times", "silence yields empty result not fabricated text"]
    },
    {
      "id": "measure",
      "upstreamEntry": "packages/estimate",
      "executionClass": "in-process",
      "permission": "owner",
      "sideEffects": false,
      "costClass": "free",
      "input": { "text": "string", "language": "bcp47", "rate?": "number" },
      "output": { "estimated": true, "durationSeconds": "number", "basis": "string" },
      "sourceArguments": [{ "argument": "--language", "status": "exposed" }],
      "testCases": ["estimate flagged estimated; ffprobe duration not overwritten"]
    },
    {
      "id": "capture.screenshot",
      "upstreamEntry": "packages/browser-capture/src/#screenshot",
      "executionClass": "browser",
      "permission": "owner",
      "sideEffects": true,
      "costClass": "free",
      "input": { "url": "http(s) URL", "viewport?": "object", "selector?": "string", "wait?": "object", "format?": "string" },
      "output": { "outputs": "[{assetId,role:'footage',mediaType}]" },
      "sourceArguments": [{ "argument": "--viewport", "status": "exposed" }],
      "testCases": ["local-web fixture pixels captured at chosen scale"]
    },
    {
      "id": "capture.run",
      "upstreamEntry": "packages/browser-capture/src/#run",
      "executionClass": "browser",
      "permission": "owner",
      "sideEffects": true,
      "costClass": "free",
      "input": { "projectScriptPath": "workspace-relative", "args?": "string[]" },
      "output": { "outputs": "[{assetId}]" },
      "sourceArguments": [{ "argument": "positional script", "status": "exposed" }],
      "testCases": ["script must belong to current project revision; host scripts rejected"]
    },
    {
      "id": "capture.install-browser",
      "upstreamEntry": "packages/browser-capture/src/#install",
      "executionClass": "local-fs",
      "permission": "operator",
      "sideEffects": true,
      "costClass": "free",
      "input": {},
      "output": { "version": "string" },
      "sourceArguments": [{ "argument": "--version", "status": "serverManaged" }],
      "testCases": ["fixed capture Chrome 153.0.8010.12; never latest"]
    },
    {
      "id": "snapshot",
      "upstreamEntry": "packages/video-cli/src/snapshot.ts",
      "executionClass": "browser",
      "permission": "owner-session",
      "sideEffects": true,
      "costClass": "free",
      "input": { "previewSessionId?": "uuid", "assetId?": "uuid", "oneOf": ["at[]", "ranges[]"], "grid?": "object", "pageSize?": "int" },
      "output": { "frames": "[{assetId,timestampSeconds}]" },
      "sourceArguments": [{ "argument": "--at/--ranges", "status": "exposed" }],
      "testCases": ["URLs/ports generated server-side; browser cannot name internal URLs"]
    },
    {
      "id": "packages.build",
      "upstreamEntry": "packages/video-cli/src/package-selection.ts + compiler",
      "executionClass": "runner-isolated",
      "permission": "owner",
      "sideEffects": true,
      "costClass": "free",
      "input": { "projectPackagePath": "workspace-relative", "revision?": "bigint" },
      "output": { "tarballHandle": "string", "diagnostics": "object[]" },
      "sourceArguments": [{ "argument": "positional path", "status": "exposed" }],
      "testCases": ["arbitrary user cmd rejected; compile output is a tarball"]
    },
    {
      "id": "packages.pack",
      "upstreamEntry": "pack pipeline",
      "executionClass": "runner-isolated",
      "permission": "owner",
      "sideEffects": true,
      "costClass": "free",
      "input": { "projectPackagePath": "workspace-relative" },
      "output": { "packageHandle": "string" },
      "sourceArguments": [{ "argument": "--pack", "status": "serverManaged" }],
      "testCases": ["packed artifact restorable in a fresh directory"]
    },
    {
      "id": "packages.install",
      "upstreamEntry": "host package install",
      "executionClass": "local-fs",
      "permission": "operator",
      "sideEffects": true,
      "costClass": "free",
      "input": { "specifier": "name@exactVersion", "scope": "project|host", "projectId?": "uuid" },
      "output": { "status": "string" },
      "sourceArguments": [{ "argument": "positional specifier", "status": "exposed" }],
      "testCases": ["latest and ranges rejected; vendor namespace cannot be overridden"]
    },
    {
      "id": "packages.status",
      "upstreamEntry": "host package inspect",
      "executionClass": "local-fs",
      "permission": "operator",
      "sideEffects": false,
      "costClass": "free",
      "input": { "specifier?": "name@exactVersion" },
      "output": { "packages": "[{name,version,ready}]" },
      "sourceArguments": [{ "argument": "--status", "status": "serverManaged" }],
      "testCases": ["native status semantics preserved"]
    }
  ]
}
